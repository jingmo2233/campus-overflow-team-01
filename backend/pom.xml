<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 父 POM：统一依赖版本（Spring Boot BOM）与插件配置 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>com.campusoverflow</groupId>
    <artifactId>campus-overflow</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>CampusOverflow :: Parent</name>
    <description>大学校园版 Stack Overflow —— 模块化单体（DDD 限界上下文 + 六边形分层）</description>

    <modules>
        <module>co-shared-kernel</module>
        <module>co-identity</module>
        <module>co-qa</module>
        <module>co-reputation</module>
        <module>co-discovery</module>
        <module>co-bootstrap</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <springdoc.version>2.8.6</springdoc.version>
        <archunit.version>1.3.0</archunit.version>
        <commonmark.version>0.24.0</commonmark.version>
        <owasp-sanitizer.version>20240325.1</owasp-sanitizer.version>
        <jacoco.version>0.8.12</jacoco.version>
        <!-- 领域层行覆盖率门禁（适应度函数 FF-4）。实测 co-qa-domain 93.24% /
             co-reputation-domain 100%（含 PR #107）/ co-discovery-domain 79.12% /
             co-identity-domain 75.74%，留出测量波动余量取 0.75；Sprint 4 目标 0.80 -->
        <domain.coverage.minimum>0.75</domain.coverage.minimum>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-identity-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-identity-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-identity-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-identity-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-identity-interfaces</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-qa-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-qa-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-qa-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-qa-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-qa-interfaces</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-reputation-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-reputation-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-reputation-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-reputation-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-reputation-interfaces</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-discovery-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-discovery-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-discovery-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-discovery-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-discovery-interfaces</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-shared-kernel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.commonmark</groupId>
                <artifactId>commonmark</artifactId>
                <version>${commonmark.version}</version>
            </dependency>
            <dependency>
                <groupId>org.commonmark</groupId>
                <artifactId>commonmark-ext-gfm-tables</artifactId>
                <version>${commonmark.version}</version>
            </dependency>
            <dependency>
                <groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
                <artifactId>owasp-java-html-sanitizer</artifactId>
                <version>${owasp-sanitizer.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
    <!-- 覆盖率门禁 = 适应度函数 FF-4：原本四个 domain 模块各挂了一份规则，
         理由却都是一样的「整体行覆盖不低于 domain.coverage.minimum」。
         集中到这里一份，规则只维护一处；阈值仍由属性统一给，各模块需要不同口径时
         再在模块 pom 里单独覆盖。 -->
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>check-coverage</id>
                        <goals><goal>check</goal></goals>
                        <!-- 不显式开启时，check 对不达标的 bundle 只打 WARNING，
                             构建仍然 BUILD SUCCESS——门禁等于形同虚设，必须先跑一次反向验证确认它会红。 -->
                        <configuration>
                            <haltOnFailure>true</haltOnFailure>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${domain.coverage.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
