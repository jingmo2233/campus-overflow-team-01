# 生产部署环境变量模板
# 用法：cp deploy/.env.example deploy/.env，然后修改所有 change_me_* 值
# 注意：deploy/.env 已被 git 忽略，严禁提交真实密码到仓库

# ── MySQL ──
# root 密码（仅首次初始化容器时生效，之后改密码需进容器操作）
MYSQL_ROOT_PASSWORD=change_me_root
# 应用账号密码（与后端容器共享）
DB_PASSWORD=change_me_app

# ── 后端 ──
# 生产环境使用 prod profile（demo 会写入演示数据，生产必须去掉）
SPRING_PROFILES=prod
# 字段加密密钥（Base64 编码的 32 字节），首次部署生成：
#   openssl rand -base64 32
# 生成后妥善保管，更换会导致已加密字段无法解密
CO_FIELD_KEY=replace_with_openssl_rand_base64_32
# 已通过 HTTPS（反向代理/证书）对外发布后改为 true，开启 Secure Cookie
COOKIE_SECURE=false

# ── 对外端口 ──
# Nginx（前端 + API 网关）监听的服务器端口；80 被占用或走外层负载均衡时修改
WEB_PORT=80

# ── 可观测性（--profile observability 时生效）──
GRAFANA_PASSWORD=change_me_grafana
